<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:obuv="clr-namespace:Obuv"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Obuv.AuthPage">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" Background="#7FFF00">
            <TextBlock Margin="12 8" FontSize="20" HorizontalAlignment="Left" Text="Авторизация" />
        </Grid>

        <!-- Расширение textbox при вводе это не баг, это фишка) -->
        <StackPanel Margin="16" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="256">
            <TextBox Watermark="Логин" Name="Login" />
            <TextBox Watermark="Пароль" PasswordChar="★" Name="Password" />
            <ContentControl Name="ErrorControl"/>
            <Button Margin="0 16 0 0" Content="Войти" Click="LoginClicked" />
            <Button Content="Войти как гость" Click="GuestClicked" />
        </StackPanel>
    </Grid>

</UserControl>